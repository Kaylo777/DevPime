# ============================================
# CONFIGURACIÓN DE DEV PIME
# Copia este archivo como ".env" y completa los valores.
#   cp .env.example .env
# ============================================

# Django
DJANGO_SECRET_KEY=tu-clave-secreta-aqui

# ---------------------------------------------------------------
# BASE DE DATOS POSTGRESQL
# ---------------------------------------------------------------
# Para usar Supabase (base de datos en la nube), sigue estos pasos:
#   1. Crea un proyecto en https://supabase.com
#   2. Ve a Settings > Database > Connection string (Pooler)
#   3. Usa los datos que aparecen ahí:
#
# A) Conexión directa (recomendada para Django):
#    DB_HOST = db.<TU_PROYECTO_REF>.supabase.co
#    DB_PORT = 5432
#
# B) O con Pooler (transaction):
#    DB_HOST = aws-0-<region>.pooler.supabase.com
#    DB_PORT = 6543
#
# C) O con Pooler (session):
#    DB_HOST = aws-0-<region>.pooler.supabase.com
#    DB_PORT = 5432
#
# El usuario SIEMPRE es: postgres.<TU_PROYECTO_REF>
#     Ejemplo: postgres.qwertyuiop
#
# La contraseña es la que configuraste al crear el proyecto (o el "Database Password"
# de Settings > Database). NUNCA la guardes en el código.
#
# Si dejas todo vacío, Django usará la base local:
#     devpime_db / postgres / damian2021 @ localhost:5432
# ---------------------------------------------------------------
DB_NAME=postgres
DB_USER=postgres.tu-proyecto-ref
DB_PASSWORD=tu-password-aqui
DB_HOST=db.tu-proyecto-ref.supabase.co
DB_PORT=5432
# 'require' para Supabase (exige SSL). 'disable' para la base local.
DB_SSLMODE=require
